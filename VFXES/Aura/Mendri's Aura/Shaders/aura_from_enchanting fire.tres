code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_disabled, diffuse_toon, specular_toon, unshaded;

uniform vec4 Maincolor : source_color;
uniform vec2 Speed;
uniform vec2 Scale;
uniform sampler2D Noise_texture;
uniform sampler2D Dissolve_sampler : repeat_disable;



void fragment() {
// ColorParameter:14
	vec4 n_out14p0 = Maincolor;


// Input:8
	float n_out8p0 = TIME;


// Vector2Parameter:7
	vec2 n_out7p0 = Speed;


// VectorOp:6
	vec2 n_out6p0 = vec2(n_out8p0) * n_out7p0;


// UVFunc:5
	vec2 n_in5p1 = vec2(1.00000, 1.00000);
	vec2 n_out5p0 = n_out6p0 * n_in5p1 + UV;


// Vector2Parameter:13
	vec2 n_out13p0 = Scale;


// UVFunc:12
	vec2 n_in12p2 = vec2(0.00000, 0.00000);
	vec2 n_out12p0 = (n_out5p0 - n_in12p2) * n_out13p0 + n_in12p2;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Noise_texture, n_out12p0);
	float n_out3p1 = n_out3p0.r;


	vec4 n_out9p0;
// Texture2D:9
	n_out9p0 = texture(Dissolve_sampler, UV);
	float n_out9p1 = n_out9p0.r;


// FloatOp:11
	float n_out11p0 = n_out3p1 - n_out9p1;


// Clamp:15
	float n_in15p1 = 0.00000;
	float n_in15p2 = 1.00000;
	float n_out15p0 = clamp(n_out11p0, n_in15p1, n_in15p2);


// Output:0
	ALBEDO = vec3(n_out14p0.xyz);
	ALPHA = n_out15p0;


}
