code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec4 Main_Color : source_color;
uniform vec2 Dissolve_Tiler;
uniform float Dissolve_Speed;
uniform sampler2D Dissolve_Texture;
uniform sampler2D Maintexture;
uniform float Emission_intensity;



void vertex() {
	mat4 n_out2p0;
// GetBillboardMatrix:2
	{
		mat4 __mvm = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0], INV_VIEW_MATRIX[1], INV_VIEW_MATRIX[2], MODEL_MATRIX[3]);
		n_out2p0 = __mvm;
	}


// Output:0
	MODELVIEW_MATRIX = n_out2p0;


}

void fragment() {
// ColorParameter:5
	vec4 n_out5p0 = Main_Color;


// Input:16
	vec2 n_out16p0 = UV;


// Vector2Parameter:17
	vec2 n_out17p0 = Dissolve_Tiler;


// VectorOp:15
	vec2 n_out15p0 = n_out16p0 * n_out17p0;


// Input:11
	float n_out11p0 = TIME;


// FloatParameter:13
	float n_out13p0 = Dissolve_Speed;


// FloatOp:12
	float n_out12p0 = n_out11p0 * n_out13p0;


// VectorCompose:14
	float n_in14p0 = 0.00000;
	vec2 n_out14p0 = vec2(n_in14p0, n_out12p0);


// UVFunc:10
	vec2 n_in10p1 = vec2(1.00000, 1.00000);
	vec2 n_out10p0 = n_out14p0 * n_in10p1 + n_out15p0;


	vec4 n_out8p0;
// Texture2D:8
	n_out8p0 = texture(Dissolve_Texture, n_out10p0);


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Maintexture, UV);


// VectorOp:6
	vec4 n_out6p0 = n_out8p0 * n_out3p0;


// VectorOp:9
	vec4 n_out9p0 = n_out5p0 + n_out6p0;


// VectorDecompose:4
	float n_out4p0 = n_out3p0.x;
	float n_out4p1 = n_out3p0.y;
	float n_out4p2 = n_out3p0.z;
	float n_out4p3 = n_out3p0.w;


// FloatParameter:19
	float n_out19p0 = Emission_intensity;


// Mix:18
	float n_in18p2 = 0.50000;
	vec4 n_out18p0 = mix(n_out9p0, vec4(n_out19p0), n_in18p2);


// Output:0
	ALBEDO = vec3(n_out9p0.xyz);
	ALPHA = n_out4p3;
	EMISSION = vec3(n_out18p0.xyz);


}
"
