[sub_resource type="Resource" id="Resource_eba0v"]
script = ExtResource("1_6k3ae")
item_name = "Jack's Aegis"
item_number = 2
item_description = "This shield once belonged to the one they call the world's strongest man, it has the power to protect the one who uses it against everything that exists, a gift from Jack once he died, said to choose a sinner among the ones that remains. Jack made this shield by using his pure strength. in fact, it is said that Jack did never need to use a shield as he would bear with his body alone any hit that would land on him, the shield was meant to be a weapon to protect all of the humans, not him"
category = "weapon"

[sub_resource type="Resource" id="Resource_6pvy7"]
script = ExtResource("1_6k3ae")
item_name = "The Hand of the Maestria"
item_number = 2
item_description = "The weapon wield by Maerlyn, the mother of all humans, said to be unbreakable, needs a godly amount of strength to be used at its peak. This hammer was said to choose a sinner as its new wielder once Maerlyn falls. The Story goes that this Hammer has no real magic despite its durability the only one who can say if it's true is no longer able to tell anything about it"
category = "weapon"

