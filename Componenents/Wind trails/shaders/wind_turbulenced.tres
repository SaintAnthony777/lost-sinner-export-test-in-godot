code = "shader_type spatial;
render_mode blend_add, depth_draw_never, depth_test_default, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec4 Main_color : source_color;
uniform vec2 Offset_parameter;
uniform float Offset_slider : hint_range(-1.0, 1.0);
uniform vec2 Scale_parameter;
uniform sampler2D Base_texture : source_color, hint_default_black, repeat_disable;
uniform float Details_slider : hint_range(-1.0, 1.0);
uniform vec2 details_scale;
uniform sampler2D Details_texture : source_color, repeat_enable;
uniform sampler2D Boundary_texture;



void fragment() {
// ColorParameter:22
	vec4 n_out22p0 = Main_color;


// Vector2Parameter:6
	vec2 n_out6p0 = Offset_parameter;


// FloatParameter:8
	float n_out8p0 = Offset_slider;


// VectorOp:9
	vec2 n_out9p0 = n_out6p0 * vec2(n_out8p0);


// UVFunc:7
	vec2 n_in7p1 = vec2(1.00000, 1.00000);
	vec2 n_out7p0 = n_out9p0 * n_in7p1 + UV;


// Vector2Parameter:5
	vec2 n_out5p0 = Scale_parameter;


// UVFunc:4
	vec2 n_in4p2 = vec2(0.00000, 0.00000);
	vec2 n_out4p0 = (n_out7p0 - n_in4p2) * n_out5p0 + n_in4p2;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Base_texture, n_out4p0);
	float n_out3p1 = n_out3p0.r;


// Input:21
	float n_out21p0 = TIME;


// FloatParameter:19
	float n_out19p0 = Details_slider;


// VectorOp:13
	vec2 n_out13p0 = vec2(n_out21p0) * vec2(n_out19p0);


// UVFunc:15
	vec2 n_in15p1 = vec2(1.00000, 1.00000);
	vec2 n_out15p0 = n_out13p0 * n_in15p1 + UV;


// Vector2Parameter:14
	vec2 n_out14p0 = details_scale;


// UVFunc:12
	vec2 n_in12p2 = vec2(0.00000, 0.00000);
	vec2 n_out12p0 = (n_out15p0 - n_in12p2) * n_out14p0 + n_in12p2;


	vec4 n_out16p0;
// Texture2D:16
	n_out16p0 = texture(Details_texture, n_out12p0);
	float n_out16p1 = n_out16p0.r;


// FloatOp:20
	float n_out20p0 = n_out3p1 * n_out16p1;


	vec4 n_out23p0;
// Texture2D:23
	n_out23p0 = texture(Boundary_texture, UV);
	float n_out23p1 = n_out23p0.r;


// FloatOp:25
	float n_out25p0 = n_out20p0 * n_out23p1;


// Output:0
	ALBEDO = vec3(n_out22p0.xyz);
	ALPHA = n_out25p0;


}
"
