code = "shader_type spatial;
render_mode blend_add, depth_draw_opaque, depth_test_default, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec4 Maincolor : source_color;
uniform sampler2D Base_texture : hint_default_black, repeat_disable;
uniform vec2 Scale_parameter;
uniform vec2 Speed_parameter;
uniform sampler2D Whirlwind_texture : repeat_enable;
uniform sampler2D Boundary_texture;



void fragment() {
// ColorParameter:19
	vec4 n_out19p0 = Maincolor;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Base_texture, UV);
	float n_out3p1 = n_out3p0.r;


// Vector2Parameter:13
	vec2 n_out13p0 = Scale_parameter;


// UVFunc:14
	vec2 n_in14p2 = vec2(0.00000, 0.00000);
	vec2 n_out14p0 = (UV - n_in14p2) * n_out13p0 + n_in14p2;


// Vector2Parameter:9
	vec2 n_out9p0 = Speed_parameter;


// Input:10
	float n_out10p0 = TIME;


// VectorOp:11
	vec2 n_out11p0 = n_out9p0 * vec2(n_out10p0);


// UVFunc:8
	vec2 n_in8p1 = vec2(1.00000, 1.00000);
	vec2 n_out8p0 = n_out11p0 * n_in8p1 + n_out14p0;


	vec4 n_out6p0;
// Texture2D:6
	n_out6p0 = texture(Whirlwind_texture, n_out8p0);
	float n_out6p1 = n_out6p0.r;


// FloatOp:12
	float n_out12p0 = n_out3p1 * n_out6p1;


	vec4 n_out16p0;
// Texture2D:16
	n_out16p0 = texture(Boundary_texture, UV);
	float n_out16p1 = n_out16p0.r;


// FloatOp:18
	float n_out18p0 = n_out12p0 * n_out16p1;


// Output:0
	ALBEDO = vec3(n_out19p0.xyz);
	ALPHA = n_out18p0;


}
"
