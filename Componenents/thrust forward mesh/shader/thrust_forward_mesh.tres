code = "shader_type spatial;
render_mode blend_add, depth_draw_never, depth_test_default, cull_disabled, diffuse_toon, specular_schlick_ggx, unshaded;

uniform vec4 Main_color : source_color;
uniform vec2 Offset_paraameter;
uniform sampler2D Main_texture : source_color;
uniform sampler2D Boundary_parameter;



void fragment() {
// ColorParameter:4
	vec4 n_out4p0 = Main_color;


// Input:12
	float n_out12p0 = TIME;


// Vector2Parameter:10
	vec2 n_out10p0 = Offset_paraameter;


// VectorOp:11
	vec2 n_out11p0 = vec2(n_out12p0) + n_out10p0;


// UVFunc:9
	vec2 n_in9p1 = vec2(1.00000, 1.00000);
	vec2 n_out9p0 = n_out11p0 * n_in9p1 + UV;


	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(Main_texture, n_out9p0);
	float n_out2p1 = n_out2p0.r;


	vec4 n_out5p0;
// Texture2D:5
	n_out5p0 = texture(Boundary_parameter, UV);
	float n_out5p1 = n_out5p0.r;


// FloatOp:7
	float n_out7p0 = n_out2p1 - n_out5p1;


// Clamp:8
	float n_in8p1 = 0.00000;
	float n_in8p2 = 1.00000;
	float n_out8p0 = clamp(n_out7p0, n_in8p1, n_in8p2);


// Output:0
	ALBEDO = vec3(n_out4p0.xyz);
	ALPHA = n_out8p0;


}
"
