code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 Mainshiner : source_color;
uniform float Shinig_Speed;
uniform sampler2D Alpha_texture;



void fragment() {
// ColorParameter:10
	vec4 n_out10p0 = Mainshiner;


// Input:6
	float n_out6p0 = TIME;


// FloatParameter:9
	float n_out9p0 = Shinig_Speed;


// FloatOp:8
	float n_out8p0 = n_out6p0 * n_out9p0;


// VectorCompose:7
	vec2 n_out7p0 = vec2(n_out8p0, n_out8p0);


// UVFunc:5
	vec2 n_in5p1 = vec2(1.00000, 1.00000);
	vec2 n_out5p0 = n_out7p0 * n_in5p1 + UV;


	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(Alpha_texture, n_out5p0);
	float n_out2p1 = n_out2p0.r;


// Clamp:4
	float n_in4p1 = 0.00000;
	float n_in4p2 = 1.00000;
	float n_out4p0 = clamp(n_out2p1, n_in4p1, n_in4p2);


// Output:0
	ALBEDO = vec3(n_out10p0.xyz);
	ALPHA = n_out4p0;


}
