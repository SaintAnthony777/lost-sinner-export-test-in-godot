code = "shader_type spatial;
render_mode blend_add, depth_draw_opaque, depth_test_default, cull_disabled, diffuse_toon, specular_schlick_ggx, unshaded;

uniform vec4 Maincolor : source_color;
uniform vec2 alpha_offset;
uniform float Speed_Given;
uniform vec2 alpha_scale;
uniform sampler2D Main_alpha;
uniform sampler2D Alpha_dissolve_gradient;
uniform float Dissolve_parameter;



void fragment() {
// ColorParameter:4
	vec4 n_out4p0 = Maincolor;


// Vector2Parameter:8
	vec2 n_out8p0 = alpha_offset;


// FloatParameter:10
	float n_out10p0 = Speed_Given;


// Input:12
	float n_out12p0 = TIME;


// FloatOp:11
	float n_out11p0 = n_out10p0 * n_out12p0;


// VectorOp:9
	vec2 n_out9p0 = n_out8p0 * vec2(n_out11p0);


// UVFunc:7
	vec2 n_in7p1 = vec2(1.00000, 1.00000);
	vec2 n_out7p0 = n_out9p0 * n_in7p1 + UV;


// Vector2Parameter:6
	vec2 n_out6p0 = alpha_scale;


// UVFunc:5
	vec2 n_in5p2 = vec2(0.00000, 0.00000);
	vec2 n_out5p0 = (n_out7p0 - n_in5p2) * n_out6p0 + n_in5p2;


	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(Main_alpha, n_out5p0);


	vec4 n_out13p0;
// Texture2D:13
	n_out13p0 = texture(Alpha_dissolve_gradient, UV);


// FloatParameter:18
	float n_out18p0 = Dissolve_parameter;


// FloatOp:17
	float n_out17p0 = n_out13p0.x * n_out18p0;


// FloatOp:15
	float n_out15p0 = n_out2p0.x - n_out17p0;


// Clamp:16
	float n_in16p1 = 0.00000;
	float n_in16p2 = 1.00000;
	float n_out16p0 = clamp(n_out15p0, n_in16p1, n_in16p2);


// Output:0
	ALBEDO = vec3(n_out4p0.xyz);
	ALPHA = n_out16p0;


}
