script = ExtResource("1_flfva")
item_name = "Disaster"
item_description = "One of the few spells that combines a swordmaster's abilities and a wiseman's knowledge. This spell casts an array of swords that will be the towering defense against any foe. Jack was all amazed when they showed him this spell, he said he never saw chaos and calm."
short_description = "A power that shows what a scholar can do with magic and swords. A spell that challenges Halfrey's sword."
